 }
+
+/**
+ * Responses 终态阻断原因。全部是本地枚举，绝不携带上游 status 原文、错误对象或响应正文，
+ * 以便各 provider 用同一套语义决定拒绝原因。
+ */
+export type ResponsesApiBlockReason =
+    | 'error'               // 顶层 error 载荷非空，即使同时附带文本
+    | 'incomplete'          // status=incomplete（max_output_tokens、content_filter 等原因）
+    | 'failed'              // status=failed
+    | 'cancelled'           // status=cancelled（远端取消，不能伪装成用户取消）
+    | 'pending'             // status=queued/in_progress，同步请求尚未生成完成
+    | 'refusal'             // 输出消息含 refusal 内容，即使附带部分文本
+    | 'message-incomplete'  // message 项带显式非 completed 状态
+    | 'unknown-status';     // 显式但无法识别的 status（null、空串、数字都不是“缺省”）
+
+/** error 缺省（null/undefined）或为空字符串时才算无错误；其余载荷一律视为显式错误。 */
+function hasResponsesApiErrorPayload(error: unknown): boolean {
+    if (error === null || error === undefined) return false;
+    if (typeof error === 'string') return error.trim().length > 0;
+    return true;
+}
+
+/**
+ * 校验 Responses 结果的终态完整性：返回 null 表示可以继续按原有文本读取规则处理，
+ * 否则返回阻断原因。只有显式 completed 才算完整响应；缺省/undefined status 为旧代理
+ * 保留原有规则，但仍要求没有错误载荷、没有显式未完成的 message、也没有 refusal。
+ */
+export function checkResponsesApiCompleteness(result: unknown): ResponsesApiBlockReason | null {
+    const payload = result as {error?: unknown; status?: unknown; output?: unknown} | null | undefined;
+    if (!payload || typeof payload !== 'object') return null;
+
+    if (hasResponsesApiErrorPayload(payload.error)) return 'error';
+
+    if (payload.status !== undefined) {
+        const status = payload.status;
+        if (typeof status !== 'string' || !status) return 'unknown-status';
+        if (status === 'incomplete') return 'incomplete';
+        if (status === 'failed') return 'failed';
+        if (status === 'cancelled') return 'cancelled';
+        if (status === 'queued' || status === 'in_progress') return 'pending';
+        if (status !== 'completed') return 'unknown-status';
+    }
+
+    if (!Array.isArray(payload.output)) return null;
+    for (const item of payload.output as any[]) {
+        if (!item || typeof item !== 'object') continue;
+        if (item.type !== 'message') continue;
+        // message 的显式非 completed 状态（含 null）不是“缺省”，不能把未完成消息当作成功。
+        if (item.status !== undefined && item.status !== 'completed') return 'message-incomplete';
+        if (Array.isArray(item.content)
+            && item.content.some((part: any) => part?.type === 'refusal')) return 'refusal';
+    }
+    return null;
+}
+
+const BLOCK_REASON_MESSAGES: Readonly<Record<ResponsesApiBlockReason, string>> = Object.freeze({
+    error: '上游返回了错误',
+    incomplete: '响应未完整生成',
+    failed: '上游报告响应失败',
+    cancelled: '响应被上游取消',
+    pending: '响应尚未生成完成',
+    refusal: '模型拒绝生成内容',
+    'message-incomplete': '响应消息未完整生成',
+    'unknown-status': '响应状态无法识别',
+});
+
+/**
+ * 构造终态阻断错误。kind/retryable 与 services/translation/errors 的结构化错误协议对齐：
+ * max_output_tokens、content_filter、refusal 与无法识别的响应都不能带着原参数盲目重试，
+ * 远端取消也绝不使用 AbortError，避免被误记为用户主动取消。
+ */
+export function createResponsesApiBlockedError(reason: ResponsesApiBlockReason, label: string): Error {
+    return Object.assign(new Error(`${label}：${BLOCK_REASON_MESSAGES[reason]}`), {
+        kind: 'response',
+        retryable: false,
+    });
+}
