+    it('缺省 status 的旧代理响应沿用原有文本读取规则并上报一次成功用量', async () => {
+        respond(terminalBody({output: messageOutput('旧代理译文'), usage}));
+        const message: any = {origin: 'hello'};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).resolves.toBe('旧代理译文');
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({outcome: 'success', usageAvailability: 'reported'});
+    });
+
+    it('顶层 error 非空时即使有文本也拒绝成功，且不回显上游错误内容', async () => {
+        respond(terminalBody({
+            status: 'failed',
+            error: {code: 'server_error', message: 'trace with sk-fake-ark-key-009 inside'},
+            output: messageOutput('部分译文'),
+            usage,
+        }));
+        const message: any = {origin: 'hello'};
+        const observations = observe(message);
+
+        const error = await doubaoSeedTranslation(message).catch((caught: unknown) => caught);
+        expect((error as Error).message).toContain('上游返回了错误');
+        expect((error as Error).message).not.toContain('sk-fake-ark-key-009');
+        expect((error as Error).message).not.toContain('server_error');
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({outcome: 'error', usageAvailability: 'reported'});
+    });
+
+    it('refusal 即使附带部分文本也拒绝成功并保留用量', async () => {
+        respond(terminalBody({
+            status: 'completed',
+            output: [{type: 'message', status: 'completed', content: [
+                {type: 'output_text', text: '前半句'},
+                {type: 'refusal', refusal: 'cannot translate'},
+            ]}],
+            usage,
+        }));
+        const message: any = {origin: 'hello'};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).rejects.toThrow('模型拒绝生成内容');
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({outcome: 'error', usageAvailability: 'reported'});
+    });
+
+    it('只有推理项没有正文时维持格式错误且保留真实用量', async () => {
+        respond(terminalBody({
+            status: 'completed',
+            output: [{type: 'reasoning', summary: [{type: 'summary_text', text: '只推理'}]}],
+            usage: {input_tokens: 8, output_tokens: 20, total_tokens: 28, output_tokens_details: {reasoning_tokens: 20}},
+        }));
+        const message: any = {origin: 'hello'};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).rejects.toThrow('缺少 Responses API 输出文本');
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({
+            outcome: 'error',
+            usageAvailability: 'reported',
+            inputTokens: 8,
+            outputTokens: 20,
+            reasoningTokens: 20,
+        });
+    });
+
+    it('批量原文中任一终态失败都不会交出“成功”的部分数组', async () => {
+        fetchMock.mockImplementation(async (_url, init) => {
+            const text = JSON.parse(String(init?.body)).input[0].content[0].text as string;
+            if (text === 'a') {
+                return json(terminalBody({status: 'incomplete', output: messageOutput('甲', 'incomplete'), usage}));
+            }
+            return json(terminalBody({status: 'completed', output: messageOutput('乙', 'completed'), usage}));
+        });
+        const message: any = {origin: ['a', 'b']};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).rejects.toThrow('响应未完整生成');
+        // 第一条失败后整批拒绝，第二条不再发出请求，数组结果不会以成功形式交付。
+        expect(fetchMock).toHaveBeenCalledTimes(1);
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({outcome: 'error', usageAvailability: 'reported'});
+    });
+
+    it('请求前已取消直接抛 AbortError，不发请求也不上报', async () => {
+        const controller = new AbortController();
+        controller.abort();
+        const message: any = {origin: 'hello', abortSignal: controller.signal};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).rejects.toMatchObject({name: 'AbortError'});
+        expect(fetchMock).not.toHaveBeenCalled();
+        expect(observations).toHaveLength(0);
+    });
+
+    it('响应读取后取消只交付取消结果，不产生迟到成功', async () => {
+        const controller = new AbortController();
