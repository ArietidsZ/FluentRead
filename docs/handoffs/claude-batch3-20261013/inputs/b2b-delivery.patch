+const json = (value: unknown, init?: ResponseInit) => new Response(JSON.stringify(value), init);
+
+function setup(apiType: 'responses' | 'chat' = 'responses') {
+    const config = new Config();
+    config.service = 'deepseek';
+    config.deepseekApiType = apiType;
+    config.token.deepseek = 'test-secret';
+    config.model.deepseek = 'deepseek-chat';
+
+    const observations: unknown[] = [];
+    const message: any = {origin: 'hello', targetLanguage: 'zh-Hans', requestTimeoutMs: 5000};
+    attachTranslationProviderConfig(message, createTranslationProviderConfigSnapshot(config as any));
+    attachTranslationModelUsageObserver(message, observation => observations.push(observation));
+
+    const fetchMock = vi.fn<typeof fetch>();
+    setRuntimeFetch(fetchMock);
+    return {message, observations, fetchMock};
+}
+
+afterEach(() => setRuntimeFetch());
+
+describe('DeepSeek Responses 终态校验与失败用量保留', () => {
+    it('completed 状态拼接多条消息文本、忽略推理项，并只上报一次成功用量', async () => {
+        const {message, observations, fetchMock} = setup();
+        fetchMock.mockImplementation(async (input) => {
+            expect(String(input)).toBe(DEEPSEEK_RESPONSES_URL);
+            return json({
+                id: 'resp_ds_1',
+                model: 'deepseek-chat-2026-01',
+                status: 'completed',
+                output: [
+                    {type: 'reasoning', summary: [{type: 'summary_text', text: '内部思考'}]},
+                    // 工具调用项即使携带形似 output_text 的内容也不得进入正文。
+                    {type: 'function_call', call_id: 'call_1', content: [{type: 'output_text', text: '工具泄漏'}]},
+                    {type: 'message', status: 'completed', content: [{type: 'output_text', text: '你'}]},
+                    {type: 'message', status: 'completed', content: [{type: 'output_text', text: '好'}]},
+                ],
+                usage: {input_tokens: 10, output_tokens: 4, total_tokens: 14, output_tokens_details: {reasoning_tokens: 2}},
+            });
+        });
+
+        await expect(deepseek(message)).resolves.toBe('你好');
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({
+            outcome: 'success',
+            usageAvailability: 'reported',
+            inputTokens: 10,
+            outputTokens: 4,
+            totalTokens: 14,
+            reasoningTokens: 2,
+            actualModel: 'deepseek-chat-2026-01',
+            statusCode: 200,
+        });
+    });
+
+    it('HTTP 200 但 status=incomplete 且带部分文本时拒绝成功，并保留真实用量', async () => {
+        const {message, observations, fetchMock} = setup();
+        fetchMock.mockImplementation(async () => json({
+            id: 'resp_ds_2',
+            // 上游实际模型与配置不同：失败观察也必须保留 actualModel。
+            model: 'deepseek-chat-0905',
+            status: 'incomplete',
+            incomplete_details: {reason: 'max_output_tokens'},
+            output: [{type: 'message', status: 'incomplete', content: [{type: 'output_text', text: '部分译文'}]}],
+            usage: {input_tokens: 10, output_tokens: 128, total_tokens: 138},
+        }));
+
+        const error = await deepseek(message).catch((caught: unknown) => caught);
+        expect(error).toBeInstanceOf(Error);
+        expect((error as Error).message).toContain('响应未完整生成');
+        // 错误文案不得回显上游 incomplete_details 或响应正文内容。
+        expect((error as Error).message).not.toContain('max_output_tokens');
+        expect((error as Error).message).not.toContain('部分译文');
+        expect(error).toMatchObject({kind: 'response', retryable: false});
