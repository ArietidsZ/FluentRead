+        });
+        const message: any = {origin: 'hello', abortSignal: controller.signal};
+        const observations = observe(message);
+
+        await expect(doubaoSeedTranslation(message)).rejects.toMatchObject({name: 'AbortError'});
+        expect(observations).toHaveLength(1);
+        expect(observations[0]).toMatchObject({outcome: 'cancelled', usageAvailability: 'unreported'});
+    });
+});
