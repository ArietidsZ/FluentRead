[
  {
    "id": "bilibili",
    "name": "哔哩哔哩",
    "match": {
      "hosts": [
        "*.bilibili.com"
      ]
    },
    "priority": 380,
    "mode": "augment",
    "exclude": [
      "#commentapp",
      "bili-comments",
      "bili-comment-thread-renderer",
      "bili-comment-renderer",
      "bili-rich-text"
    ]
  },
  {
    "id": "github",
    "name": "GitHub",
    "match": {
      "hosts": [
        "github.com"
      ]
    },
    "priority": 500,
    "mode": "augment",
    "content": [
      {
        "css": [
          ".markdown-title"
        ],
        "key": "github-markdown-title",
        "resolve": "closest",
        "atomic": true
      },
      {
        "css": [
          "h1.gh-header-title .js-issue-title",
          "[data-testid=\"issue-title\"]",
          "[data-testid=\"pull-request-title\"]",
          "[data-testid=\"issue-pr-title-link\"]"
        ],
        "key": "github-issue-or-pr-title",
        "resolve": "closest",
        "atomic": true
      },
      {
        "css": [
          ".markdown-body p",
          ".markdown-body h1",
          ".markdown-body h2",
          ".markdown-body h3",
          ".markdown-body h4",
          ".markdown-body h5",
          ".markdown-body h6",
          ".markdown-body li",
          ".markdown-body blockquote",
          ".markdown-body figcaption",
          ".markdown-body summary",
          ".markdown-body dt",
          ".markdown-body dd",
          ".markdown-body th",
          ".markdown-body td"
        ],
        "key": "github-markdown-prose",
        "resolve": "closest"
      },
      {
        "css": [
          "[itemprop=\"about\"]",
          "[itemprop=\"description\"]",
          "[data-testid=\"repository-description\"]",
          ".repo-description p",
          ".repos-list-description",
          "p.f4.my-3"
        ],
        "key": "github-repository-description",
        "resolve": "closest",
        "atomic": true
      }
    ],
    "protect": [
      "[data-testid=\"issue-labels\"]",
      "span[class*=\"IssueLabel\"]",
      "[data-testid=\"list-row-repo-name-and-number\"]",
      "[data-testid=\"created-at\"]",
      "[class*=\"IssueItem-module__defaultNumberDescription\"]",
      "[class*=\"PinnedIssue-module__metadataContainer\"]",
      "[class*=\"PinnedIssue-module__issueMetadata\"]",
      "[class*=\"IssueBodyHeader-module__IssueBodyHeaderContainer\"]",
      "[aria-live]",
      "[role=\"status\"]",
      "[role=\"alert\"]",
      "[data-turbo-permanent]",
      "[data-turbo-temporary]",
      "relative-time",
      "time-ago",
      "local-time",
      "[class*=\"ReposListItem-module__TopicsList\"]",
      "[class*=\"ReposListItem-module__LabelsContainer\"]",
      "[data-listview-item-visibility-label=\"true\"]"
    ],
    "exclude": [
      "dialog",
      "[role=\"dialog\"]",
      "[data-testid=\"search-modal\"]",
      "[data-target=\"query-builder.queryBuilder\"]",
      "[data-target=\"qbsearch-input.queryBuilder\"]",
      ".js-command-palette-dialog",
      "#command-palette-pjax-container",
      "form[role=\"search\"]",
      ".js-site-search-form",
      "input[data-target=\"qbsearch-input.inputButton\"]",
      "[data-testid=\"issue-labels\"]",
      "span[class*=\"IssueLabel\"]",
      "[data-testid=\"list-row-repo-name-and-number\"]",
      "[data-testid=\"created-at\"]",
      "[class*=\"IssueItem-module__defaultNumberDescription\"]",
      "[class*=\"PinnedIssue-module__metadataContainer\"]",
      "[class*=\"PinnedIssue-module__issueMetadata\"]",
      "[class*=\"IssueBodyHeader-module__IssueBodyHeaderContainer\"]",
      "[class*=\"ReposListItem-module__TopicsList\"]",
      "[class*=\"ReposListItem-module__LabelsContainer\"]",
      "[data-listview-item-visibility-label=\"true\"]"
    ],
    "watchIgnore": [
      "[data-testid=\"issue-labels\"]",
      "span[class*=\"IssueLabel\"]",
      "[data-testid=\"list-row-repo-name-and-number\"]",
      "[data-testid=\"created-at\"]",
      "[class*=\"IssueItem-module__defaultNumberDescription\"]",
      "[class*=\"PinnedIssue-module__metadataContainer\"]",
      "[class*=\"PinnedIssue-module__issueMetadata\"]",
      "[class*=\"IssueBodyHeader-module__IssueBodyHeaderContainer\"]",
      "dialog",
      "[role=\"dialog\"]",
      "form[role=\"search\"]",
      "[aria-live]",
      "[role=\"status\"]",
      "[role=\"alert\"]",
      "[data-turbo-permanent]",
      "[data-turbo-temporary]",
      "relative-time",
      "time-ago",
      "local-time",
      "[class*=\"ReposListItem-module__TopicsList\"]",
      "[class*=\"ReposListItem-module__LabelsContainer\"]",
      "[data-listview-item-visibility-label=\"true\"]"
    ],
    "omit": [
      "[class*=\"ReposListItem-module__TopicsList\"]",
      "[class*=\"ReposListItem-module__LabelsContainer\"]",
      "[data-listview-item-visibility-label=\"true\"]"
    ]
  },
  {
    "id": "x",
    "name": "X / Twitter",
    "match": {
      "hosts": [
        "*.x.com",
        "*.twitter.com"
      ]
    },
    "priority": 400,
    "mode": "augment",
    "content": [
      {
        "css": [
          "[data-testid=\"tweetText\"]"
        ],
        "key": "x-post-text",
        "resolve": "closest"
      },
      {
        "css": [
          "[data-testid=\"UserDescription\"]"
        ],
        "key": "x-user-description",
        "resolve": "closest"
      },
      {
        "css": [
          "[data-testid=\"twitterArticleReadView\"] p"
        ],
        "key": "x-article-prose",
        "resolve": "closest"
      }
    ],
    "protect": [
      "time",
      "[role=\"progressbar\"]",
      "[data-testid=\"app-bar-back\"]"
    ],
    "exclude": [
      "[data-testid=\"tweetTextarea_0\"]",
      "[data-testid=\"DMComposerTextInput\"]",
      "[data-testid=\"User-Name\"]",
      "[data-testid=\"UserName\"]"
    ]
  },
  {
    "id": "reddit",
    "name": "Reddit",
    "match": {
      "hosts": [
        "*.reddit.com",
        "*.redd.it"
      ]
    },
    "priority": 390,
    "mode": "focus",
    "content": [
      {
        "css": [
          "shreddit-post [slot=\"title\"]",
          "h1[id^=\"post-title-\"]"
        ],
        "key": "reddit-post-title",
        "resolve": "closest",
        "atomic": true
      },
      {
        "css": [
          "shreddit-post [slot=\"text-body\"] p",
          "shreddit-post [slot=\"text-body\"] li",
          "shreddit-post [slot=\"text-body\"] blockquote",
          "shreddit-post [slot=\"text-body\"] h1",
          "shreddit-post [slot=\"text-body\"] h2",
          "shreddit-post [slot=\"text-body\"] h3",
          "shreddit-post [slot=\"text-body\"] h4",
          "shreddit-post [slot=\"text-body\"] h5",
          "shreddit-post [slot=\"text-body\"] h6",
          "[data-testid=\"post-content\"] p",
          "[data-testid=\"post-content\"] li",
          "[data-testid=\"post-content\"] blockquote",
          "[data-click-id=\"text\"] p",
          "[data-click-id=\"text\"] li",
          "[data-click-id=\"body\"] p",
          "[data-click-id=\"body\"] h1",
          "[data-click-id=\"body\"] h2",
          "[data-click-id=\"body\"] h3",
          "[data-click-id=\"body\"] h4",
          "[data-click-id=\"body\"] h5",
          "[data-click-id=\"body\"] h6"
        ],
        "key": "reddit-post-prose",
        "resolve": "closest"
      },
      {
        "css": [
          "shreddit-comment [slot=\"comment\"] p",
          "shreddit-comment [slot=\"comment\"] li",
          "shreddit-comment [slot=\"comment\"] blockquote",
          "shreddit-comment [id$=\"-comment-rtjson-content\"] p",
          "[data-testid=\"comment\"] p",
          "[data-testid=\"comment\"] li",
          "[data-click-id=\"comment\"] p"
        ],
        "key": "reddit-comment-prose",
        "resolve": "closest"
      }
    ],
    "protect": [
      "button",
      "[role=\"button\"]",
      "[role=\"menuitem\"]",
      "faceplate-timeago",
      "[data-testid=\"post_timestamp\"]",
      "[data-testid=\"vote-arrows\"]"
    ],
    "exclude": [
      "reddit-composer",
      "[data-testid=\"comment-submission-form\"]"
    ],
    "watchIgnore": [
      "button",
      "[role=\"button\"]",
      "[role=\"menuitem\"]",
      "faceplate-timeago",
      "[data-testid=\"post_timestamp\"]",
      "[data-testid=\"vote-arrows\"]",
      "shreddit-status",
      "[aria-live]"
    ]
  },
  {
    "id": "hacker-news",
    "name": "Hacker News",
    "match": {
      "hosts": [
        "news.ycombinator.com"
      ]
    },
    "priority": 380,
    "mode": "augment",
    "content": [
      {
        "css": [
          ".titleline > a"
        ],
        "key": "hacker-news-story-title",
        "resolve": "closest",
        "atomic": true
      },
      {
        "css": [
          "span.commtext",
          ".toptext"
        ],
        "key": "hacker-news-comment-prose",
        "resolve": "closest"
      }
    ],
    "protect": [
      ".rank",
      ".sitestr",
      ".score",
      ".hnuser",
      ".age",
      ".subtext",
      ".pagetop"
    ],
    "watchIgnore": [
      ".age",
      ".score"
    ]
  },
  {
    "id": "youtube",
    "name": "YouTube",
    "match": {
      "hosts": [
        "*.youtube.com",
        "youtu.be"
      ]
    },
    "priority": 370,
    "mode": "augment",
    "content": [
      {
        "css": [
          "ytd-watch-metadata h1 yt-formatted-string"
        ],
        "key": "youtube-video-title",
        "resolve": "closest",
        "atomic": true
      },
      {
        "css": [
          "#description-inline-expander yt-attributed-string",
          "ytd-text-inline-expander yt-attributed-string"
        ],
        "key": "youtube-description",
        "resolve": "closest"
      },
      {
        "css": [
          "ytd-comment-view-model #content-text",
          "ytd-comment-renderer #content-text"
        ],
        "key": "youtube-comment",
        "resolve": "closest"
      },
      {
        "css": [
          "ytd-transcript-segment-renderer .segment-text"
        ],
        "key": "youtube-transcript-segment",
        "resolve": "closest"
      }
    ],
    "protect": [
      "#owner-sub-count",
      "#info span",
      "yt-formatted-string#vote-count-middle"
    ],
    "exclude": [
      "#movie_player",
      "ytd-live-chat-frame",
      "yt-live-chat-app",
      "ytd-video-preview",
      "input#search",
      "ytd-comment-simplebox-renderer"
    ]
  },
  {
    "id": "gnu-manual",
    "name": "GNU 手册",
    "match": {
      "hosts": [
        "*.gnu.org"
      ]
    },
    "priority": 360,
    "mode": "augment",
    "content": [
      {
        "css": [
          ".section-level-extent > p",
          ".chapter-level-extent > p",
          ".subsection-level-extent > p"
        ],
        "key": "gnu-manual-prose",
        "resolve": "closest"
      }
    ],
    "exclude": [
      ".nav-panel"
    ]
  },
  {
    "id": "learnopengl",
    "name": "LearnOpenGL",
    "match": {
      "hosts": [
        "*.learnopengl.com"
      ]
    },
    "priority": 300,
    "mode": "augment",
    "exclude": [
      "#nav"
    ]
  },
  {
    "id": "x-chat",
    "name": "X Chat 消息页脚",
    "match": {
      "hosts": [
        "chat.x.com"
      ]
    },
    "priority": 410,
    "mode": "augment",
    "omit": [
      "div.flex.items-center.ml-auto.shrink-0.gap-1"
    ]
  },
  {
    "id": "ubuntu-manpage",
    "name": "Ubuntu 命令手册",
    "match": {
      "hosts": [
        "manpages.ubuntu.com"
      ],
      "paths": [
        "/manpages/*/man0*/*.html",
        "/manpages/*/man1*/*.html",
        "/manpages/*/man2*/*.html",
        "/manpages/*/man3*/*.html",
        "/manpages/*/man4*/*.html",
        "/manpages/*/man5*/*.html",
        "/manpages/*/man6*/*.html",
        "/manpages/*/man7*/*.html",
        "/manpages/*/man8*/*.html",
        "/manpages/*/man9*/*.html"
      ]
    },
    "priority": 360,
    "mode": "augment",
    "literalTokens": [
      "#manpage-content section.Sh b",
      "#manpage-content section.Sh i"
    ],
    "omit": [
      "#main-content h1",
      "#manpage-content > #synopsis + section.Sh"
    ],
    "watchIgnore": [
      "#main-content h1",
      "#manpage-content > #synopsis + section.Sh"
    ],
    "literalLabels": [
      "#manpage-content > #description + section.Sh > p.Pp:has(+ .Bd-indent)"
    ]
  }
]
